{
  "name": "cortex-desktop",
  "version": "1.0.0",
  "description": "CORTEX Desktop — local-first AI second brain",
  "type": "module",
  "main": "main.js",
  "author": "CORTEX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis portable",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cortex.desktop",
    "productName": "CORTEX",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", ".env.example"],
    "extraResources": [
      {
        "from": "..",
        "to": "app-server/cortex",
        "filter": [
          "*.mjs",
          "package.json",
          "public/**/*",
          "!node_modules/**/*",
          "!desktop/**/*",
          "!docs/**/*",
          "!test/**/*",
          "!backups/**/*",
          "!.git/**/*",
          "!cortex.db*"
        ]
      },
      {
        "from": "../node_modules",
        "to": "app-server/cortex/node_modules",
        "filter": ["**/*", "!sqlite3/**/*", "!.bin/**/*", "!.cache/**/*"]
      },
      {
        "from": "../../memory",
        "to": "app-server/memory",
        "filter": ["embed.mjs"]
      }
    ],
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CORTEX"
    },
    "portable": { "artifactName": "CORTEX-${version}-portable.exe" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity" },
    "linux": { "target": ["AppImage"], "category": "Utility" }
  }
}
